{
  "expo": {
    "name": "Fynn",
    "slug": "fynn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fynn",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fynn.ledger",
      "appleTeamId": "JFSHHUGWF8",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Fynn uses Face ID to unlock your ledger on this device.",
        "NSLocalNetworkUsageDescription": "Fynn se conecta al servidor de desarrollo en esta red para cargar la app."
      }
    },
    "android": {
      "package": "com.fynn.ledger",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#06140F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06140F",
          "resizeMode": "contain",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "ios": {
            "image": "./assets/images/splash-ios.png",
            "resizeMode": "cover",
            "backgroundColor": "#06140F",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "imageWidth": 200,
            "backgroundColor": "#06140F"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "./plugins/withFynnCapture"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
